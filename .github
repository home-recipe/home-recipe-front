# 1. 워크플로우(자동화 작업)의 이름을 정합니다.
name: Flutter Web Deploy 

# 2. 언제 이 로봇을 깨울지 정합니다.
on:
  push:
    branches: [ feature/REQ-001/login-view ]  # main 브랜치에 코드가 push(업로드)될 때마다 실행됩니다.

# 3. 로봇이 해야 할 일들을 정의합니다.
jobs:
  build-and-deploy:
    runs-on: ubuntu-latest  # 최신 리눅스 가상 환경에서 작업을 시작합니다.
    steps:
      # [Step 1] GitHub 저장소에 있는 미경님의 코드를 가상 환경으로 가져옵니다.
      - name: 코드 가져오기
        uses: actions/checkout@v3

      # [Step 2] 빌드를 위해 가상 환경에 플러터 엔진을 설치합니다.
      - name: 플러터 설정
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable' # 안정화 버전을 사용합니다.

      # [Step 3] 플러터 웹 빌드를 진행합니다.
      - name: 웹 빌드 시작
        run: |
          flutter pub get                        # 패키지 설치
          flutter build web --web-renderer html --release  # HTML 렌더러 방식으로 배포용 파일 생성

      # [Step 4] 빌드된 결과물을 미경님의 실제 서버로 전송합니다.
      - name: 서버로 파일 전송 (SCP)
        uses: appleboy/scp-action@master
        with:
          host: ${{ secrets.SERVER_IP }}         # 아까 등록한 금고(Secret)에서 IP를 꺼내옵니다.
          username: root                         # 서버 접속 계정
          key: ${{ secrets.SSH_PRIVATE_KEY }}    # 등록한 마스터키(Secret)로 인증합니다.
          source: "build/web/*"                  # 전송할 원본 (빌드된 웹 파일들)
          target: "/var/www/html"                # 도착할 서버 경로
          strip_components: 2                    # [중요] 'build/web' 폴더 구조를 깎아내고 내용물만 보냅니다.

      # [Step 5] 서버 전송 후 마무리 정리 작업을 진행합니다.
      - name: 서버 권한 정리 및 Nginx 재시작 (SSH)
        uses: appleboy/ssh-action@master
        with:
          host: ${{ secrets.SERVER_IP }}
          username: root
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            # 1. assets/assets 중복 생성 문제 해결 (있을 경우만 작동)
            if [ -d "/var/www/html/assets/assets" ]; then
                sudo cp -r /var/www/html/assets/assets/* /var/www/html/assets/
                sudo rm -rf /var/www/html/assets/assets
            fi

            # 2. 서버 파일들을 웹 서버(www-data)가 읽을 수 있게 권한 조정
            sudo chown -R www-data:www-data /var/www/html
            sudo chmod -R 755 /var/www/html

            # 3. 변경사항 적용을 위해 Nginx 웹 서버를 재시작합니다.
            sudo systemctl restart nginx
            echo "✨ 모든 배포 과정이 성공적으로 끝났습니다!"